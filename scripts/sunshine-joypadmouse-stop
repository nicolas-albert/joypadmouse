#!/usr/bin/env bash
set -euo pipefail

USER_UID="$(id -u)"
DEFAULT_RUNDIR="/run/user/${USER_UID}"
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  RUNDIR="${XDG_RUNTIME_DIR}"
elif [[ -d "${DEFAULT_RUNDIR}" ]]; then
  RUNDIR="${DEFAULT_RUNDIR}"
else
  RUNDIR="/tmp"
fi
PIDFILE="${RUNDIR}/joypadmouse.pid"

if [[ ! -f "${PIDFILE}" ]]; then
  exit 0
fi

pid="$(cat "${PIDFILE}" 2>/dev/null || true)"
rm -f "${PIDFILE}"

if [[ -z "${pid}" ]]; then
  exit 0
fi

if ! kill -0 "${pid}" 2>/dev/null; then
  exit 0
fi

kill "${pid}" 2>/dev/null || true

for _ in {1..50}; do
  if ! kill -0 "${pid}" 2>/dev/null; then
    exit 0
  fi
  sleep 0.1
done

kill -9 "${pid}" 2>/dev/null || true
