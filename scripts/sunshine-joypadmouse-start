#!/usr/bin/env bash
set -euo pipefail

USER_UID="$(id -u)"
DEFAULT_RUNDIR="/run/user/${USER_UID}"
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  RUNDIR="${XDG_RUNTIME_DIR}"
elif [[ -d "${DEFAULT_RUNDIR}" ]]; then
  RUNDIR="${DEFAULT_RUNDIR}"
else
  RUNDIR="/tmp"
fi
PIDFILE="${RUNDIR}/joypadmouse.pid"
LOGFILE="${RUNDIR}/joypadmouse.log"

DEVICE="${JOYPADMOUSE_DEVICE:-${SUNSHINE_JOYMOUSE_DEVICE:-auto}}"
MOUSE_TOGGLE="${JOYPADMOUSE_MOUSE_TOGGLE:-start+lb}"
MANGOHUD_TOGGLE="${JOYPADMOUSE_MANGOHUD_TOGGLE:-${SUNSHINE_JOYMOUSE_MANGOHUD_TOGGLE:-lb+rb+start}}"
MANGOHUD_REPEAT="${JOYPADMOUSE_MANGOHUD_REPEAT:-${SUNSHINE_JOYMOUSE_MANGOHUD_REPEAT:-1}}"
MANGOHUD_DELAY_MS="${JOYPADMOUSE_MANGOHUD_DELAY_MS:-${SUNSHINE_JOYMOUSE_MANGOHUD_DELAY_MS:-80}}"
MANGOHUD_PREKEY="${JOYPADMOUSE_MANGOHUD_PREKEY:-${SUNSHINE_JOYMOUSE_MANGOHUD_PREKEY:-none}}"
MANGOHUD_PREKEY_DELAY_MS="${JOYPADMOUSE_MANGOHUD_PREKEY_DELAY_MS:-${SUNSHINE_JOYMOUSE_MANGOHUD_PREKEY_DELAY_MS:-80}}"
HOLD_MS="${JOYPADMOUSE_HOLD_MS:-${SUNSHINE_JOYMOUSE_HOLD_MS:-4000}}"
SPEED="${JOYPADMOUSE_SPEED:-${SUNSHINE_JOYMOUSE_SPEED:-300}}"
WHEEL_RATE="${JOYPADMOUSE_WHEEL_RATE:-${SUNSHINE_JOYMOUSE_WHEEL_RATE:-4.5}}"
DEADZONE="${JOYPADMOUSE_DEADZONE:-${SUNSHINE_JOYMOUSE_DEADZONE:-8000}}"
POLL_HZ="${JOYPADMOUSE_POLL_HZ:-${SUNSHINE_JOYMOUSE_POLL_HZ:-125}}"
LOG_EVENTS="${JOYPADMOUSE_LOG_EVENTS:-${SUNSHINE_JOYMOUSE_LOG_EVENTS:-0}}"

LOG_EVENTS_FLAG=""
case "${LOG_EVENTS}" in
  1|true|TRUE|yes|YES|on|ON)
    LOG_EVENTS_FLAG="--log-events"
    ;;
esac

if [[ -f "${PIDFILE}" ]]; then
  pid="$(cat "${PIDFILE}" 2>/dev/null || true)"
  if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
    exit 0
  fi
fi

nohup joypadmouse \
  --device "${DEVICE}" \
  --mouse-toggle "${MOUSE_TOGGLE}" \
  --mangohud-toggle "${MANGOHUD_TOGGLE}" \
  --mangohud-repeat "${MANGOHUD_REPEAT}" \
  --mangohud-delay-ms "${MANGOHUD_DELAY_MS}" \
  --mangohud-prekey "${MANGOHUD_PREKEY}" \
  --mangohud-prekey-delay-ms "${MANGOHUD_PREKEY_DELAY_MS}" \
  --hold-ms "${HOLD_MS}" \
  --speed "${SPEED}" \
  --wheel-rate "${WHEEL_RATE}" \
  --deadzone "${DEADZONE}" \
  --poll-hz "${POLL_HZ}" \
  ${LOG_EVENTS_FLAG} \
  >>"${LOGFILE}" 2>&1 &

echo "$!" > "${PIDFILE}"
